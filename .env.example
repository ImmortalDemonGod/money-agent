# Template. Copy to .env and fill. .env is gitignored (verified: .gitignore:1).
# NEVER commit real keys. The pre-push hook will not save you from a leaked key.

# ============================================================================
# VERIFIER ONLY -- these must NEVER reach the agent's sandbox.
# This separation IS the experiment. If the agent can read STRIPE_READ_KEY it
# can compute (and therefore forge) its own P&L, and the run is void.
# ============================================================================

# Stripe RESTRICTED key, READ-ONLY. Dashboard -> Developers -> API keys ->
# Create restricted key. Grant Read on: Balance, Balance transactions, Charges,
# Payouts. Everything else None.
STRIPE_READ_KEY=rk_live_REPLACE_ME

# Card spend feed. Privacy.com -> Settings -> API. Optional if using CARD_CSV.
PRIVACY_READ_KEY=REPLACE_ME

# Fallback if not using Privacy.com: path to a card statement CSV
# with columns date,amount,description (amount = positive dollars spent).
# CARD_CSV=/path/to/money-agent/ledger/raw/card_manual.csv

# If your card has NO API (any prepaid that is not Privacy.com), set this instead. Spend then
# stays UNKNOWN (null, never 0) and the cap is enforced by the card issuer, which is the only
# hard enforcement anyway. The prediction falsifier (received_usd > 0) does not need spend.
# CARD_SOURCE=issuer_enforced

# The cap. Set this to the number you are happy to PAY FOR THE ANSWER, because
# the most likely outcome is the agent spends it and returns nothing. That is
# the finding, not a failure.
CARD_CAP_USD=REPLACE_ME

# OPTIONAL -- mechanically guaranteed post-payment obligations (P5/P7). ALL values are
# verifier-only and default off. The verifier publishes a non-secret capability fact; the agent
# cannot grant itself permission by setting these in its own environment. The class enables only
# when every value is valid and positive and the refund key is present.
# OBLIGATION_CLASS_ENABLE=1
# STRIPE_REFUND_KEY=rk_live_REPLACE_WITH_REFUND_ONLY_KEY
# EXPOSURE_MAX_OPEN=2
# EXPOSURE_MAX_SINGLE_USD=25
# EXPOSURE_MAX_TOTAL_FRACTION=0.5
# OBLIGATION_MAX_DEADLINE_H=48

# OPTIONAL -- the run's own inference cost (issue #41), so truth.json can carry inference_usd and
# net_usd_full and a retro can state full economics from the ledger alone. CSV with columns
# date,usd, exported from the provider's usage page (or kept by hand). Unset -> the fields stay
# null: unknown is not zero. A header-only file is a measured zero; an empty file fails closed.
# INFERENCE_CSV=/path/to/inference_costs.csv

# OPTIONAL -- the verified-edge rail (issue #6). PAPER account keys; bin/edge_pnl.py pulls the
# broker's books and publishes ledger/edge.json. Leave unset to keep the rail inert. Note Alpaca
# keys are not scoped read-only: what grounds this rail is that the VERIFIER pulls the broker's
# books and publishes to the ledger branch -- the agent cannot fabricate a fill either way.
# ALPACA_PAPER_KEY_ID=REPLACE_ME
# ALPACA_PAPER_SECRET_KEY=REPLACE_ME
# ALPACA_PAPER_BASE=https://paper-api.alpaca.markets

# OPTIONAL -- Base/USDC marketplace receive rail (issue #30). BASE_RPC_URL arms it. The verifier
# freezes a safe/finalized block at run start and scores only transfers exactly bound to a
# marketplace settlement event's payer, payee, and amount. The RPC must report Base mainnet chain
# ID 8453 or the pull fails closed. Topic/word indexes are ABI-specific; derive them from the
# deployed contract and complete SETUP.md's authorization + live acceptance before use.
# Arming also requires $MONEY_AGENT_STATE/base_usdc_live_acceptance.json, bound to these values.
# BASE_RPC_URL=https://base-mainnet.example.invalid
# BASE_SETTLEMENT_ADDRESS=0xREPLACE_AGENT_WALLET
# BASE_MARKETPLACE_ADDRESS=0xREPLACE_ESCROW_CONTRACT
# BASE_SETTLEMENT_EVENT_TOPIC0=0xREPLACE_EVENT_SIGNATURE
# BASE_SETTLEMENT_PAYER_TOPIC=1
# BASE_SETTLEMENT_PAYEE_TOPIC=2
# BASE_SETTLEMENT_AMOUNT_WORD=0
# BASE_FINALITY_TAG=safe
# BASE_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913


# ============================================================================
# AGENT SANDBOX ONLY -- goes in the sandbox, not here.
# Listed for reference so the boundary is legible in one place.
# ============================================================================

# Stripe RESTRICTED key, WRITE. Grant Write on: Products, Prices, Payment links,
# Checkout sessions. Balance and Payouts MUST be None -- it sells, it does not
# audit itself.
# STRIPE_WRITE_KEY=rk_live_REPLACE_ME

# The card NUMBER goes in the sandbox. The issuer's hard limit is the only real
# cap; CARD_CAP_USD above is just the tripwire that halts the loop.
